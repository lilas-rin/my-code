DATABASE_DRIVER=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fastapi
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Optional: set DATABASE_URL instead of the individual DATABASE_* variables above.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fastapi

JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
